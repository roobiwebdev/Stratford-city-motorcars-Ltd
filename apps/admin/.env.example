# ============================================================================
# Stratford City Motorcars — admin environment
# Copy to apps/admin/.env. Every value here is visible in the browser.
# ============================================================================

# mock: in-browser sample data (default; nothing else needed)
# api:  the real API at NEXT_PUBLIC_ADMIN_API_URL
NEXT_PUBLIC_ADMIN_DATA=mock

# The admin API origin. Required when NEXT_PUBLIC_ADMIN_DATA=api.
NEXT_PUBLIC_ADMIN_API_URL=

# The public website, for "view on website" links and photographs stored as
# site-relative paths (/media/…). In development: http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
